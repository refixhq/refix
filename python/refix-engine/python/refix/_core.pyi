import builtins
import decimal
import enum
from collections.abc import Sequence
from datetime import date, datetime, time
from typing import Never, Self, overload

from refix import values
from refix.enums import Unrecognized
from refix.errors import GarbledReason

class RawMessage:
    @property
    def bytes(self) -> builtins.bytes: ...
    def get(self, tag: int) -> builtins.bytes | None: ...
    def get_str(self, tag: int) -> str | None: ...
    def get_int(self, tag: int) -> int | None: ...
    def get_bool(self, tag: int) -> bool | None: ...
    def get_decimal(self, tag: int) -> decimal.Decimal | None: ...
    def get_utc_timestamp(self, tag: int) -> datetime | None: ...
    def get_utc_timestamp_ns(self, tag: int) -> int | None: ...
    def get_date(self, tag: int) -> date | None: ...
    def get_time(self, tag: int) -> time | None: ...
    def get_time_ns(self, tag: int) -> int | None: ...
    def get_month_year(self, tag: int) -> values.MonthYear | None: ...
    def get_multiple_values(self, tag: int) -> tuple[str, ...] | None: ...
    def get_group(
        self, table: GroupTable, known: KnownTags
    ) -> tuple[Scope, ...] | None: ...
    def entries(self) -> list[tuple[int, builtins.bytes]]: ...

class Scope:
    def get(self, tag: int) -> builtins.bytes | None: ...
    def get_str(self, tag: int) -> str | None: ...
    def get_int(self, tag: int) -> int | None: ...
    def get_bool(self, tag: int) -> bool | None: ...
    def get_decimal(self, tag: int) -> decimal.Decimal | None: ...
    def get_utc_timestamp(self, tag: int) -> datetime | None: ...
    def get_utc_timestamp_ns(self, tag: int) -> int | None: ...
    def get_date(self, tag: int) -> date | None: ...
    def get_time(self, tag: int) -> time | None: ...
    def get_time_ns(self, tag: int) -> int | None: ...
    def get_month_year(self, tag: int) -> values.MonthYear | None: ...
    def get_multiple_values(self, tag: int) -> tuple[str, ...] | None: ...
    def get_group(
        self, table: GroupTable, known: KnownTags
    ) -> tuple[Scope, ...] | None: ...

class GroupTable:
    def __init__(
        self,
        count_tag: int,
        delimiter: int,
        members: Sequence[int],
        nested: Sequence[GroupTable],
    ) -> None: ...

class KnownTags:
    def __init__(self, tags: Sequence[int]) -> None: ...

class Dialect:
    def __init__(self, *, extra_length_tags: Sequence[int] = ...) -> None: ...

class Tokenizer:
    def __init__(self, dialect: Dialect | None = None) -> None: ...
    def tokenize(self, data: bytes) -> RawMessage: ...

class Message:
    def __init__(self, raw: RawMessage, /) -> None: ...
    @classmethod
    def from_raw(cls, raw: RawMessage, /) -> Self: ...
    @property
    def raw(self) -> RawMessage: ...

class Component:
    def __init__(self, raw: RawMessage | Scope, /) -> None: ...
    @classmethod
    def from_raw(cls, raw: RawMessage | Scope, /) -> Self: ...
    @property
    def raw(self) -> RawMessage | Scope: ...

class GroupInstance:
    def __init__(self, raw: Scope, /) -> None: ...
    @classmethod
    def from_raw(cls, raw: Scope, /) -> Self: ...
    @property
    def raw(self) -> Scope: ...

class Group[I: GroupInstance](_Field[tuple[I, ...]]):
    def __init__(self, tag: int, instance: type[I], /) -> None: ...
    @overload
    def __get__(self, obj: None, owner: type, /) -> Self: ...
    @overload
    def __get__(self, obj: object, owner: type, /) -> tuple[I, ...]: ...

class View[C: Component]:
    def __init__(self, component: type[C], /) -> None: ...
    @overload
    def __get__(self, obj: None, owner: type, /) -> Self: ...
    @overload
    def __get__(self, obj: object, owner: type, /) -> C: ...
    def __set__(self, obj: object, value: Never, /) -> None: ...

class Str[T](_Field[T]):
    @overload
    def __init__(self: Str[str], tag: int, /) -> None: ...
    @overload
    def __init__[E: enum.StrEnum](
        self: Str[E | Unrecognized[str]], tag: int, enum: type[E], /
    ) -> None: ...

class Int[T](_Field[T]):
    @overload
    def __init__(self: Int[int], tag: int, /) -> None: ...
    @overload
    def __init__[E: enum.IntEnum](
        self: Int[E | Unrecognized[int]], tag: int, enum: type[E], /
    ) -> None: ...

class Decimal(_Field[decimal.Decimal]): ...
class Bool(_Field[bool]): ...
class Bytes(_Field[bytes]): ...
class Date(_Field[date]): ...
class Time(_Field[time]): ...
class TimeNs(_Field[int]): ...
class UtcTimestamp(_Field[datetime]): ...
class UtcTimestampNs(_Field[int]): ...
class MonthYear(_Field[values.MonthYear]): ...

class MultipleValues[T](_Field[tuple[T, ...]]):
    @overload
    def __init__(self: MultipleValues[str], tag: int, /) -> None: ...
    @overload
    def __init__[E: enum.StrEnum](
        self: MultipleValues[E | Unrecognized[str]], tag: int, enum: type[E], /
    ) -> None: ...

class _Field[T]:
    def __init__(self, tag: int, /) -> None: ...
    @overload
    def __get__(self, obj: None, owner: type, /) -> Self: ...
    @overload
    def __get__(self, obj: object, owner: type, /) -> T | None: ...
    def __set__(self, obj: object, value: Never, /) -> None: ...

class FieldWriter:
    def __init__(self) -> None: ...
    def write(self, tag: int, value: bytes) -> None: ...
    def write_str(self, tag: int, value: str) -> None: ...
    def write_int(self, tag: int, value: int) -> None: ...
    def write_bool(self, tag: int, value: bool) -> None: ...
    def write_decimal(self, tag: int, value: decimal.Decimal | int) -> None: ...
    def write_date(self, tag: int, value: date) -> None: ...
    def write_time(self, tag: int, value: time, *, precision: int = 3) -> None: ...
    def write_time_ns(self, tag: int, value: int, *, precision: int = 9) -> None: ...
    def write_utc_timestamp(
        self, tag: int, value: datetime, *, precision: int = 3
    ) -> None: ...
    def write_utc_timestamp_ns(
        self, tag: int, value: int, *, precision: int = 9
    ) -> None: ...
    def write_month_year(self, tag: int, value: values.MonthYear) -> None: ...
    def finish(self) -> RawMessage: ...

class Garble:
    @property
    def bytes(self) -> builtins.bytes: ...
    @property
    def reason(self) -> GarbledReason: ...

class MessageStream:
    def __init__(self, dialect: Dialect | None = None) -> None: ...
    def feed(self, data: bytes) -> None: ...
    def next_message(self) -> RawMessage | Garble | None: ...

class LogReader:
    def __init__(
        self, dialect: Dialect | None = None, separator: int | None = None
    ) -> None: ...
    def feed(self, data: bytes) -> None: ...
    def next_record(self) -> tuple[bytes, RawMessage, list[str]] | None: ...
    def finish(self) -> list[tuple[bytes, RawMessage, list[str]]]: ...

MALFORMED_TAG: int

def version() -> str: ...
